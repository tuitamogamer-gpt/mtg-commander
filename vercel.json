{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @mtgc/server exec prisma generate --schema prisma/postgres.prisma && pnpm --filter @mtgc/shared build && pnpm --filter @mtgc/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|api).*)", "destination": "/index.html" }
  ]
}
