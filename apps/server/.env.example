# Copy to .env and adjust. The dev setup auto-creates .env if missing.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Comma-separated allowed origins for CORS / Socket.IO (the Vite dev server).
# CORS_ORIGIN is accepted as an alias.
CLIENT_ORIGIN="http://localhost:5173"

# Optional cookie Domain attribute for production cross-subdomain auth
# (e.g. ".example.com"). Leave unset for localhost.
# COOKIE_DOMAIN=

NODE_ENV="development"

# Optional: error tracking. When set, wire @sentry/node in src/observability.ts.
# SENTRY_DSN=

# --- Production (Postgres) ---
# Use the Postgres schema and point DATABASE_URL at your database, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/mtgc"
#   pnpm --filter @mtgc/server exec prisma db push --schema prisma/postgres.prisma
