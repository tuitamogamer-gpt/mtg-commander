# Web build-time config.
# In dev, leave VITE_API_URL unset — Vite proxies /api and /socket.io to :4000.
# For a split-origin deploy (web on Vercel, API on Railway), set this to the API
# origin so the SPA and sockets target the backend directly:
#   VITE_API_URL=https://your-server.up.railway.app
VITE_API_URL=
