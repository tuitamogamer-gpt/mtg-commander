# Root env for docker-compose. Copy to .env and fill in.
#   cp .env.example .env

# Postgres credentials (used by the postgres service and the server's DATABASE_URL)
POSTGRES_USER=mtgc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mtgc

# REQUIRED: a long random string. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin the browser loads the web app from (used for CORS + cookie). Match WEB_PORT.
CLIENT_ORIGIN=http://localhost:8080

# Optional: cookie Domain for cross-subdomain auth in real deployments
# (e.g. .example.com). Leave blank for localhost / single-host.
COOKIE_DOMAIN=

# Host port the web (nginx) container is published on.
WEB_PORT=8080
